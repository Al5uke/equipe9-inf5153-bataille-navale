@startuml
skinparam linetype ortho
skinparam rectangleStyle roundCorner
skinparam nodeBorderColor #004c70
skinparam nodeBackgroundColor #8fd3ff
hide circle

title Diagramme de déploiement – Bataille Navale (mode local et en ligne)

' ======================
' === CLIENT JOUEUR 1 ==
' ======================
node "Client Joueur 1" as Client1 {
  artifact "Application BatailleNavale.jar" as App1

  component "InterfaceConsole /\nVueGraphique" as UI1
  component "ServiceJeu" as Service1
  component "Domaine du jeu\n(Jeu, Joueur, Grille,\nNavire, Statistiques)" as Domaine1
  component "JoueurIA\n(Stratégie aléatoire / ciblée)" as IA1
  database "Fichier SQLite local" as DBLocal1

  UI1 --> Service1 : commandes utilisateur
  Service1 --> Domaine1 : logique de jeu
  Service1 --> IA1 : mode solo (IA)
  App1 -down-> DBLocal1 : persistance locale
}

' ======================
' === CLIENT JOUEUR 2 ==
' ======================
node "Client Joueur 2" as Client2 {
  artifact "Application BatailleNavale.jar" as App2

  component "InterfaceConsole /\nVueGraphique" as UI2
  component "ServiceJeu" as Service2
  component "Domaine du jeu\n(Jeu, Joueur, Grille,\nNavire, Statistiques)" as Domaine2

  UI2 --> Service2
  Service2 --> Domaine2
}

' ======================
' === SERVEUR DE JEU ===
' ======================
node "Serveur de Jeu" as Server {
  component "Service de Matchmaking" as MM
  component "API Réseau /\nContrôleur principal" as API
}

' =========================
' === BASE DE DONNÉES   ===
' =========================
node "Serveur BD centrale" as DBServer {
  database "SQLite centrale\n(scores, classements)" as DBCentral
}

' ========= LIENS RÉSEAU =========
Client1 -[#blue]-> Server : TCP/HTTP\n(recherche adversaire)
Client2 -[#blue]-> Server : TCP/HTTP\n(recherche adversaire)

Client1 -[#green]-> Client2 : échanges de coups\n(mode multijoueur)

Server -[#brown]-> DBServer : JDBC/SQL\n(sauvegarde stats)

@enduml