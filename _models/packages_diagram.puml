@startuml
title Diagramme de packages

package "Interface utilisateur" {
  class "InterfaceJoueur"
}

package "Logique du jeu" {
  class "Jeu"
  class "Joueur"
  class "Grille"
  class "Case"
  class "Navire"
}

package "IA" {
  class "IAStrategie"
}

package "GestionStatistiques" {
  class "Statistiques"
}

package "Données" {
  class "BaseDeDonnees"
}

"Interface utilisateur" ..> "Logique du jeu" : <<import>>
"Logique du jeu" ..> "IA" : <<use>>
"Logique du jeu" ..> "GestionStatistiques" : <<import>>
"GestionStatistiques" ..> "Données" : <<import>>

@enduml

