@startuml
title Architecture en couches (3-tiers) – Bataille Navale

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam linetype ortho

' ==========================
' COUCHE 1 : PRÉSENTATION
' ==========================
package "Présentation\n(UI / Interface homme-machine)" #ADD8E6 {
  [InterfaceConsole]
  [VueGraphique]
}

' ==========================
' COUCHE 2 : MÉTIER
' (logique applicative + domaine)
' ==========================
package "Métier\n(Logique applicative + Domaine)" #98FB98 {
  [ServiceJeu]

  [Jeu]
  [Joueur]
  [Grille]
  [Case]
  [Navire]
  [Statistiques]

  interface StrategieIA
  [StrategieAleatoire]
  [StrategieCiblee]

  StrategieAleatoire -|> StrategieIA
  StrategieCiblee -|> StrategieIA
}

' ==========================
' COUCHE 3 : DONNÉES
' ==========================
package "Données\n(Persistance / Base de données)" #F4A460 {
  [BaseDeDonnees]
  [SQLite]
}

' ===== DÉPENDANCES ENTRE COUCHES (HAUT -> BAS) =====

[InterfaceConsole] --> [ServiceJeu]
[VueGraphique] --> [ServiceJeu]

[ServiceJeu] --> [Jeu]
[Jeu] --> [Joueur]
[Jeu] --> [Grille]
[Jeu] --> [Statistiques]

[Joueur] --> StrategieIA

[Jeu] --> [BaseDeDonnees]
[BaseDeDonnees] --> [SQLite]

' ===== NOTES (optionnelles pour GRASP) =====
note right of [ServiceJeu]
GRASP : Controller / Low Coupling
Coordonne UI, logique métier et persistance.
end note

note bottom of [Grille]
GRASP : Information Expert
Connaît les cases & navires, calcule TOUCHÉ/COULÉ.
end note

note right of [BaseDeDonnees]
GRASP : Pure Fabrication
Isole l'accès à SQLite du domaine métier.
end note

@enduml
